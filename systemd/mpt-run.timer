[Unit]
Description=Twice-daily model monitoring run, at the same two times every day

[Timer]
# 03:00 UTC (10 pm US Eastern, quiet) and 15:00 UTC (10 am US Eastern, busy).
OnCalendar=*-*-* 03:00:00 UTC
OnCalendar=*-*-* 15:00:00 UTC
# If the server was off at a scheduled time, run once when it comes back.
Persistent=true

[Install]
WantedBy=timers.target